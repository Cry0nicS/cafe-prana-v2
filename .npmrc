# @vercel/analytics 2.0.1 declares an optional peer of vue-router@^4, but this
# project requires vue-router@5 (via @nuxtjs/i18n 10.5). The analytics runtime
# works fine with vue-router 5 — the peer range is just stale. Relax peer
# resolution until @vercel/analytics ships a stable release widening the range.
legacy-peer-deps=true
