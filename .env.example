# Public URL, used for OG Image when running nuxt generate
NUXT_PUBLIC_SITE_URL=

# Supabase, used by the server reservation endpoint.
# The service-role key is required: the reservations table grants nothing to the
# anon role (see supabase/migrations). Never expose this key to the client.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Mailgun, used after a reservation has been stored
NUXT_MAILGUN_BASE_URL=https://api.eu.mailgun.net
NUXT_MAILGUN_KEY=
NUXT_MAILGUN_DOMAIN=mail.cafeprana.de
NUXT_RESERVATION_EMAIL_FROM="Cafe Prana <reservation@mail.cafeprana.de>"
NUXT_RESERVATION_EMAIL_TO=cafeprana.berlin@gmail.com
NUXT_RESERVATION_EMAIL_BCC=info@cafeprana.de

# Contact form emails (used by the server contact endpoint)
NUXT_CONTACT_EMAIL_FROM="Cafe Prana <hello@mail.cafeprana.de>"
NUXT_CONTACT_EMAIL_TO=info@cafeprana.de

# Nuxt Studio CMS — login to the editor at /pranas in production.
# Recommended: Google OAuth, so the owner signs in with her Gmail.
#   1. Create a Google OAuth Client. Authorized redirect URI:
#        https://<your-domain>/__nuxt_studio/auth/google
#   2. STUDIO_GOOGLE_MODERATORS = comma-separated allowlist of emails allowed
#      to log in (e.g. just the owner's Gmail). This is the access control.
#   3. STUDIO_GITHUB_TOKEN = a GitHub token with write access to the repo;
#      Studio commits published changes with it (Google login alone does not
#      grant repo access).
# See docs/studio-access.md for the full setup.
STUDIO_GOOGLE_CLIENT_ID=
STUDIO_GOOGLE_CLIENT_SECRET=
STUDIO_GOOGLE_MODERATORS=
STUDIO_GITHUB_TOKEN=

# Alternative: GitHub OAuth (editors sign in with GitHub; access = repo collaborators).
# STUDIO_GITHUB_CLIENT_ID=
# STUDIO_GITHUB_CLIENT_SECRET=
